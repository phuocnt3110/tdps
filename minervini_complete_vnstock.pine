//@version=5
indicator("Minervini Complete System", shorttitle="MM_Complete", overlay=true, max_labels_count=50)

// ══════════════════════════════════════════════════════════════════
// MINERVINI COMPLETE: Dual Mode System
// ABOVE THE LINE (ATL): Minervini SEPA Method - Super Stocks
// BELOW THE LINE (BTL): Weinstein-Darvas Method - Recovery Plays
// Auto-switches based on MA structure
// ══════════════════════════════════════════════════════════════════

// ==========================
// INPUTS
// ==========================
// Trend inputs
benchmarkSymbol = input.symbol("HOSE:VNINDEX", "Benchmark (RS)")
nearHighPct     = input.float(25.0, "Near 52W High Threshold %", minval=1, maxval=50)
bars52          = input.int(252, "Bars for 52 weeks", minval=50, maxval=400)

// Pattern inputs
baseLen       = input.int(30, "Base Length (bars)", minval=15, maxval=100)
atrLen        = input.int(14, "ATR Length")
vcpSegLen     = input.int(7,  "T-Segment Length")
pivotLook     = input.int(5,  "Pivot Lookback")
htfMinGain    = input.float(80.0, "HTF Min Prior Gain %")

// Weinstein-Darvas inputs (Below The Line mode)
darvasBoxLen  = input.int(20, "Darvas Box Length (bars)", minval=10, maxval=50)
darvasMaxWidth = input.float(15.0, "Darvas Max Box Width %", minval=5, maxval=30)
rsiOversoldLookback = input.int(100, "RSI Oversold Lookback (bars)", minval=20, maxval=200)

// Display inputs - toggle plots that may affect Y-axis scale
showMA20      = input.bool(true, "Show MA20")
showMA50      = input.bool(true, "Show MA50")
showMA150     = input.bool(false, "Show MA150 (may compress chart)")
showMA200     = input.bool(false, "Show MA200 (may compress chart)")
showPivot     = input.bool(true, "Show Entry/Pivot")
showStopTP    = input.bool(false, "Show Stop/TP levels (may compress chart)")

// Fundamental data toggle - DISABLE for indices/forex/crypto to avoid errors
enableFundamentals = input.bool(false, "Enable Fundamentals (stocks only)", group="Data Settings")

// Panel Export - Alert with full panel content for copying
enablePanelExport = input.bool(false, "Enable Panel Export Alert", group="Data Settings", tooltip="Khi bật, mỗi khi có tín hiệu BUY sẽ tạo alert chứa toàn bộ nội dung panel. Bạn có thể copy từ Alert Log.")

// Log to Console - Output panel content to Pine Script Console for copying
enableLogToConsole = input.bool(false, "Log Panel to Console (for copy)", group="Data Settings", tooltip="Bật toggle này → Mở Pine Editor → Xem Console tab → Copy nội dung. Chỉ log bar cuối cùng.")

// ══════════════════════════════════════════════════════════════════
// PART 1: TREND TEMPLATE (Stage 2 Analysis)
// ══════════════════════════════════════════════════════════════════

// Moving averages
ma20  = ta.sma(close, 20)
ma50  = ta.sma(close, 50)
ma150 = ta.sma(close, 150)
ma200 = ta.sma(close, 200)
volMa = ta.sma(volume, 20)

// EMA for pullback buy detection (Minervini: 10/21 EMA as pullback support)
float ema10 = ta.ema(close, 10)
float ema21 = ta.ema(close, 21)

// Chaikin Buy/Sell Volume Approximation
// Buy pressure = volume * (close - low) / (high - low)
// Sell pressure = volume * (high - close) / (high - low)
float hlRange = high - low
float buyVol  = hlRange > 0 ? volume * (close - low) / hlRange : volume * 0.5
float sellVol = hlRange > 0 ? volume * (high - close) / hlRange : volume * 0.5
float buyPct  = volume > 0 ? buyVol / volume * 100 : 50
float buyVolMA5  = ta.sma(buyVol, 5)
float sellVolMA5 = ta.sma(sellVol, 5)

// Relative Strength
benchClose = request.security(benchmarkSymbol, timeframe.period, close)
rsRaw      = benchClose != 0.0 ? close / benchClose : na
rsLookback = math.min(200, bar_index + 1)
rsHigh     = ta.highest(rsRaw, rsLookback)
rsLow      = ta.lowest(rsRaw, rsLookback)
rsRange    = rsHigh - rsLow
rsNorm     = rsRange != 0.0 ? 100.0 * (rsRaw - rsLow) / rsRange : na

// 52-week metrics - ANTI-REPAINT: Use [1] to exclude current bar
lookback52     = math.min(bars52, bar_index + 1)
hi52           = ta.highest(high[1], lookback52)  // Exclude current bar
lo52           = ta.lowest(low[1], lookback52)    // Exclude current bar
distFrom52High = hi52 != 0.0 ? (close - hi52) / hi52 * 100.0 : na
isNearHigh     = not na(distFrom52High) and distFrom52High >= -nearHighPct
aboveLow30pct  = close >= lo52 * 1.3  // 30% above 52W low

price52Ago = bar_index > bars52 ? close[bars52] : na
perf52w    = not na(price52Ago) and price52Ago != 0.0 ? (close - price52Ago) / price52Ago * 100.0 : na

// Trend conditions (Minervini Trend Template)
condPriceAboveAll = close > ma50 and close > ma150 and close > ma200
condMaStacked     = ma50 > ma150 and ma150 > ma200
condMaSlope       = ma50 > ma50[5] and ma150 >= ma150[5] and ma200 >= ma200[5]
condRsUp          = rsNorm > rsNorm[5]
condVolStrong     = volume > volMa

// Trend Score (max 10)
trendScore = 0
trendScore += condPriceAboveAll ? 2 : 0
trendScore += condMaStacked     ? 2 : 0
trendScore += condMaSlope       ? 2 : 0
trendScore += isNearHigh        ? 2 : 0
trendScore += condRsUp          ? 1 : 0
trendScore += condVolStrong     ? 1 : 0

isStage2   = trendScore >= 8
isStage2OK = trendScore >= 5 and trendScore < 8

// ══════════════════════════════════════════════════════════════════
// ABOVE THE LINE / BELOW THE LINE DETECTION
// ══════════════════════════════════════════════════════════════════
// ATL (Minervini): MA50 > MA150 > MA200 + Price above all
// BTL (Weinstein-Darvas): Not meeting ATL criteria
bool isAboveTheLine = condPriceAboveAll and condMaStacked
bool isBelowTheLine = not isAboveTheLine

// Switch Point Detection
bool switchToATL = isAboveTheLine and not isAboveTheLine[1]  // BTL → ATL
bool switchToBTL = isBelowTheLine and not isBelowTheLine[1]  // ATL → BTL

// ══════════════════════════════════════════════════════════════════
// WEINSTEIN STAGE ANALYSIS (For BTL Mode)
// ══════════════════════════════════════════════════════════════════
// Weinstein uses 30-week MA on weekly chart ≈ 150 bars on daily
float ma30w = ta.sma(close, 150)  // Approximation of 30-week MA
float ma30wSlope = ma30w - ma30w[10]  // Slope over 10 bars

// Stage Detection (Weinstein)
// Stage 1: Price around MA30W, MA30W flat (basing)
// Stage 2: Price > MA30W, MA30W rising (advancing)
// Stage 3: Price around MA30W, MA30W flattening (topping)
// Stage 4: Price < MA30W, MA30W falling (declining)
bool wStage1 = math.abs(close - ma30w) / ma30w * 100 < 5 and math.abs(ma30wSlope) / ma30w * 100 < 1
bool wStage2Early = close > ma30w and ma30wSlope > 0 and close > ma30w * 1.02
bool wStage4 = close < ma30w and ma30wSlope < 0

// Stage 1 Breakout (transition to Stage 2)
bool wStage1Breakout = close > ma30w and close[1] <= ma30w[1] and volume > volMa * 1.3

// Stage 3: Topping - above MA but slope flattening, EXCLUDES other stages
bool wStage3 = close > ma30w and math.abs(ma30wSlope) / ma30w * 100 < 0.5 and not wStage1 and not wStage2Early and not wStage1Breakout

// Weinstein Score (for BTL mode)
int weinsteinScore = 0
weinsteinScore += wStage1 ? 30 : 0
weinsteinScore += wStage2Early ? 50 : 0
weinsteinScore += wStage1Breakout ? 40 : 0
weinsteinScore += (close > ma20 and ma20 > ma20[5]) ? 20 : 0  // Short-term momentum
weinsteinScore += (volume > volMa) ? 10 : 0

string weinsteinStage = wStage4 ? "Stage 4 (Decline)" : wStage1Breakout ? "Stage 1→2 Breakout" : wStage2Early ? "Stage 2 (Advancing)" : wStage3 ? "Stage 3 (Topping)" : wStage1 ? "Stage 1 (Basing)" : "Transition"
string weinsteinGrade = weinsteinScore >= 70 ? "A" : weinsteinScore >= 50 ? "B" : weinsteinScore >= 30 ? "C" : "F"

// ══════════════════════════════════════════════════════════════════════
// DARVAS BOX DETECTION (For BTL Mode)
// ══════════════════════════════════════════════════════════════════════
// Darvas Box: Price consolidation range - ANTI-REPAINT
float darvasHigh = ta.highest(high[1], darvasBoxLen)  // Exclude current bar
float darvasLow = ta.lowest(low[1], darvasBoxLen)     // Exclude current bar
float darvasWidth = (darvasHigh - darvasLow) / darvasLow * 100
bool validDarvasBox = darvasWidth <= darvasMaxWidth and darvasWidth >= 3  // Not too wide, not too tight

// Darvas Breakout - ANTI-REPAINT FIX:
// Problem: barstate.isconfirmed is TRUE for ALL historical bars, causing retroactive signals
// Solution: Use var to store breakout state, only trigger on actual crossover
// darvasHigh already uses high[1] so it's "locked" for each bar
bool darvasBreakoutCondition = close > darvasHigh and close[1] <= darvasHigh  // Raw crossover condition

// Store breakout state using var - prevents recalculation
var bool darvasBreakoutTriggered = false
var int darvasBreakoutBar = 0

// Only set breakout on the bar it actually happens (crossover detection)
if darvasBreakoutCondition and not darvasBreakoutCondition[1]
    darvasBreakoutTriggered := true
    darvasBreakoutBar := bar_index

// Reset if price drops significantly below darvasHigh
if close < darvasHigh * 0.95
    darvasBreakoutTriggered := false
    darvasBreakoutBar := 0

// darvasBreakout is TRUE only on the bar it triggered
bool darvasBreakout = darvasBreakoutBar == bar_index
bool darvasBreakoutActive = darvasBreakoutTriggered and close > darvasHigh and close <= darvasHigh * 1.05  // Within 5% of breakout
bool darvasVolConfirm = volume > volMa * 1.5

// Darvas Box Score
int darvasScore = 0
darvasScore += validDarvasBox ? 30 : 0
darvasScore += darvasBreakout and darvasVolConfirm ? 50 : 0
darvasScore += darvasBreakoutActive ? 30 : 0
darvasScore += (close > darvasLow + (darvasHigh - darvasLow) * 0.7) ? 20 : 0  // Price in upper 30% of box

string darvasStatus = darvasBreakout and darvasVolConfirm ? "BOX BREAKOUT!" : darvasBreakoutActive ? "In Breakout Zone" : validDarvasBox ? "Box Formed" : "No Valid Box"
string darvasGrade = darvasScore >= 70 ? "A" : darvasScore >= 50 ? "B" : darvasScore >= 30 ? "C" : "F"

// BTL Combined Score (will be updated after RSI/EMA score is calculated)
var int btlScore = 0
var string btlGrade = "F"

// ══════════════════════════════════════════════════════════════════
// BTL ENHANCEMENTS (Weinstein-Darvas Philosophy)
// ══════════════════════════════════════════════════════════════════

// 1. Weekly RSI Oversold (Setup condition - mean reversion)
float rsiWeekly = request.security(syminfo.tickerid, "W", ta.rsi(close, 14))
bool weeklyOversold = rsiWeekly < 30
bool weeklyOversoldRecovering = rsiWeekly > 30 and rsiWeekly[1] <= 30  // Just crossed above 30
int barsSinceOversold = ta.barssince(weeklyOversold)
bool wasOversoldRecently = not na(barsSinceOversold) and barsSinceOversold <= rsiOversoldLookback  // RSI was < 30 within lookback

// 2. EMA Cross (Alternative entry trigger)
float ema12 = ta.ema(close, 12)
float ema36 = ta.ema(close, 36)
bool emaCrossUp = ta.crossover(ema12, ema36)
bool emaAbove = ema12 > ema36

// 3. RSI/EMA Score (NEW - integrated into BTL scoring)
int rsiEmaScore = 0
rsiEmaScore += weeklyOversold ? 15 : rsiWeekly < 40 ? 5 : 0           // RSI Oversold: +15, Low: +5
rsiEmaScore += weeklyOversoldRecovering ? 10 : 0                      // RSI recovering from oversold: +10
rsiEmaScore += emaCrossUp ? 20 : emaAbove ? 10 : 0                    // EMA cross: +20, Above: +10
rsiEmaScore += (volume > volMa * 1.3) ? 10 : 0                        // Volume confirmation: +10
string rsiEmaGrade = rsiEmaScore >= 35 ? "A" : rsiEmaScore >= 25 ? "B" : rsiEmaScore >= 15 ? "C" : "F"

// UPDATE BTL Combined Score (Weinstein + Darvas + RSI/EMA)
btlScore := math.round((weinsteinScore + darvasScore + rsiEmaScore) / 3)
btlGrade := btlScore >= 60 ? "A" : btlScore >= 45 ? "B" : btlScore >= 30 ? "C" : "F"

// 4. Accumulation Detection - defined later after upVolMA/downVolMA calculation

// 4. Market Stage Check (Weinstein: check market stage before buying)
float indexMA30w = request.security(benchmarkSymbol, timeframe.period, ta.sma(close, 150))
float indexSlope = indexMA30w - indexMA30w[10]
bool marketStage4 = benchClose < indexMA30w and indexSlope < 0
bool marketOKforBTL = not marketStage4  // Avoid BTL buys when market in Stage 4

// 5. BTL Exit Signals (Weinstein-Darvas)
bool btlStopHit = close < darvasLow * 0.98  // Break below box low with 2% buffer
bool btlStage3Warning = wStage3  // Unified with STAGE section definition
bool btlEnterStage4 = close < ma30w and close[1] >= ma30w[1]  // Price breaks below MA30W
bool btlFailedBreakout = close < darvasHigh and close[1] >= darvasHigh  // Back into box (darvasHigh already excludes current bar)

// BTL Exit Status
string btlExitStatus = btlStopHit ? "🔴 STOP HIT" : btlEnterStage4 ? "🔴 STAGE 4" : btlFailedBreakout ? "⚠️ FAILED BO" : btlStage3Warning ? "🟡 STAGE 3 WARN" : "🟢 HOLD"

// ═══════════════════════════════════════════════════════════════════
// BTL BUY SIGNAL - ANTI-REPAINT FIX
// ═══════════════════════════════════════════════════════════════════
// Problem: wStage1Breakout, wStage2Early can change as MAs recalculate
// Solution: Store BTL buy signal state using var

// BTL Reference Indicators (display-only, not buy conditions)
float volMA7 = ta.sma(volume, 7)
float btlVolRatio7d = volMA7 > 0 ? volume / volMA7 : 0          // Vol today vs 7d avg (winners ~0.6x)
float btlPreMomentum7d = close[7] > 0 ? (close - close[7]) / close[7] * 100 : 0  // 7d price change (winners <7%)

// Unified BTL buy condition - ALL must be true:
// 1. RSI weekly was oversold recently (stock was beaten down)
// 2. Darvas box valid + breakout + volume confirm
// 3. EMA12 > EMA36 (daily momentum confirmed)
// 4. Not Stage 4 + market OK + stop/RR filters
bool btlDarvasOK = validDarvasBox and darvasBreakout and darvasVolConfirm
bool btlRsiOK = wasOversoldRecently
bool btlEmaOK = emaAbove
// BTL entry-level filters (Stop & R:R) - enforce BTL Guide rules
float btlStopPctCalc = close > darvasLow ? (close - darvasLow) / close * 100 : 99
bool btlStopOK = btlStopPctCalc <= 10  // Max 10% stop for BTL (relaxed vs ATL 8%)
float btlRRcalc = btlStopPctCalc > 0 ? 20.0 / btlStopPctCalc : 0  // TP 20%
bool btlRRok = btlRRcalc >= 2.0  // Min 2:1 R:R per BTL Guide
bool btlBuyCondition = isBelowTheLine and marketOKforBTL and btlStopOK and btlRRok and btlDarvasOK and btlRsiOK and btlEmaOK and not wStage4

// Store BTL buy signal state using var - PREVENTS RETROACTIVE SIGNALS
var bool btlBuyTriggered = false
var int btlBuyBar = 0
var string btlEntryTypeStored = "None"

// Only trigger BTL buy on actual signal bar (not recalculated)
if btlBuyCondition and not btlBuyCondition[1]
    btlBuyTriggered := true
    btlBuyBar := bar_index
    btlEntryTypeStored := "Darvas+RSI"

// Reset BTL signal if exit conditions met
if btlStopHit or btlEnterStage4 or (close < darvasLow * 0.95)
    btlBuyTriggered := false
    btlBuyBar := 0
    btlEntryTypeStored := "None"

// Final BTL signals - btlBuySignal TRUE only on the bar it triggered
bool btlBuySignal = btlBuyBar == bar_index  // TRUE only on buy bar (for bar coloring)

// Real-time versions for panel display
bool btlBuySignal_RT = btlBuyCondition  // Real-time (can show during day)
bool btlInPosition = btlBuyTriggered and close > darvasLow  // Still in valid BTL trade

// BTL Signal Memory - track last BUY for panel display
var int lastBTLBuyBar = 0
var float lastBTLBuyClose = 0.0
var float lastBTLDarvasHigh_mem = 0.0
if btlBuySignal
    lastBTLBuyBar := bar_index
    lastBTLBuyClose := close
    lastBTLDarvasHigh_mem := darvasHigh
int btlBarsAgo = lastBTLBuyBar > 0 ? bar_index - lastBTLBuyBar : -1

// Watch and Ready signals (these are OK to recalculate - not for entry)
bool btlWatchSignal = isBelowTheLine and wasOversoldRecently and (validDarvasBox or emaAbove)
bool btlReadySignal = isBelowTheLine and wasOversoldRecently and emaAbove and validDarvasBox and close > darvasLow + (darvasHigh - darvasLow) * 0.8

// BTL Entry Type (for display)
string btlEntryType = btlBuySignal ? btlEntryTypeStored : btlBuySignal_RT ? "Darvas+RSI" : "None"

// ══════════════════════════════════════════════════════════════════
// PART 2: BASE/SETUP QUALITY (Pattern Detection) - ATL Mode
// ══════════════════════════════════════════════════════════════════

// Core metrics - USE [1] TO PREVENT REPAINTING (exclude current bar)
// CRITICAL FIX: Only use CONFIRMED (closed) bars for calculations
baseHigh = ta.highest(high[1], baseLen)  // Exclude current bar to prevent repaint
baseLow  = ta.lowest(low[1], baseLen)    // Exclude current bar to prevent repaint
baseDepthPct = (baseHigh - baseLow) / baseHigh * 100
pricePosPct  = (close - baseLow) / (baseHigh - baseLow) * 100
pivotDist    = (baseHigh - close) / baseHigh * 100

// Prior trend
priorLow  = ta.lowest(low[baseLen], baseLen)
priorGain = (baseHigh - priorLow) / priorLow * 100

// VCP (T-Count)
atrPct = ta.atr(atrLen) / close * 100
atr_T1 = ta.sma(atrPct, vcpSegLen * 4)
atr_T2 = ta.sma(atrPct, vcpSegLen * 3)
atr_T3 = ta.sma(atrPct, vcpSegLen * 2)
atr_T4 = ta.sma(atrPct, vcpSegLen)

t1 = atr_T1 > atr_T2
t2 = atr_T2 > atr_T3
t3 = atr_T3 > atr_T4
tCount = (t1 ? 1 : 0) + (t2 ? 1 : 0) + (t3 ? 1 : 0)
hasVCPchar = tCount >= 2

// Volume
upVol   = close > close[1] ? volume : 0
downVol = close < close[1] ? volume : 0
upVolMA   = ta.sma(upVol, 10)
downVolMA = ta.sma(downVol, 10)
volMA20 = ta.sma(volume, 20)
volMA50 = ta.sma(volume, 50)
volDryUp = volMA20 < volMA50 * 0.8
accumRatio = upVolMA / math.max(downVolMA, 1)
volHealthy = upVolMA >= downVolMA

// BTL Accumulation Detection (Weinstein: smart money accumulating in Stage 1)
bool btlAccumulating = upVolMA > downVolMA * 1.2  // Buying volume > Selling volume

// Tight action
rangePct = (high - low) / close * 100
rangeMA5 = ta.sma(rangePct, 5)
rangeMA20 = ta.sma(rangePct, 20)
tightnessRatio = rangeMA5 / rangeMA20
higherLows = ta.lowest(low, pivotLook) >= ta.lowest(low, pivotLook * 2)
isTight = tightnessRatio < 0.9 and higherLows

// Pattern detection
isHTF = priorGain >= htfMinGain and baseDepthPct <= 25 and baseDepthPct >= 10 and tightnessRatio < 0.6 and pricePosPct >= 70
isCup = baseDepthPct >= 15 and baseDepthPct <= 65 and pricePosPct >= 70 and tightnessRatio < 0.85 and tCount >= 1 and volDryUp
low1 = ta.lowest(low, baseLen / 2)
low2 = ta.lowest(low[baseLen/2], baseLen / 2)
hasWShape = math.abs(low1 - low2) / low1 * 100 < 5
isDoubleBottom = hasWShape and baseDepthPct >= 15 and baseDepthPct <= 50 and pricePosPct >= 60 and hasVCPchar
isFlatBase = baseDepthPct <= 15 and pricePosPct >= 80 and volHealthy
pivotLow1 = ta.lowest(low, pivotLook)
pivotLow2 = ta.lowest(low[pivotLook], pivotLook)
pivotLow3 = ta.lowest(low[pivotLook*2], pivotLook)
isAscending = pivotLow1 > pivotLow2 and pivotLow2 > pivotLow3 and baseDepthPct <= 35 and pricePosPct >= 50
isPowerPlay = pivotDist <= 3 and tightnessRatio < 0.5 and volDryUp and hasVCPchar
isVCP = hasVCPchar and baseDepthPct <= 35 and pricePosPct >= 70 and isTight and volDryUp

// Low-Cheat Pivot Detection (Minervini: buy at bottom of last VCP contraction)
// Entry BEFORE breakout when VCP is confirmed (T >= 2) and price is at contraction low
float lastContractionLow  = ta.lowest(low, vcpSegLen)
float lastContractionHigh = ta.highest(high, vcpSegLen)
float contractionRange    = lastContractionHigh > 0 ? (lastContractionHigh - lastContractionLow) / lastContractionHigh * 100 : 100
bool  atContractionLow    = close <= lastContractionLow * 1.02  // Within 2% of contraction low
bool  isLowCheat = hasVCPchar and tCount >= 2 and atContractionLow and volDryUp and isTight and contractionRange <= 8 and pricePosPct >= 50

// Pattern classification
string patternName = "NO SETUP"
int patternScore = 0
color patternColor = color.gray

if isPowerPlay
    patternName := "POWER PLAY"
    patternScore := 95
    patternColor := color.fuchsia
else if isHTF
    patternName := "HIGH TIGHT FLAG"
    patternScore := 90
    patternColor := color.lime
else if isVCP
    patternName := "VCP (" + str.tostring(tCount) + "T)"
    patternScore := 85
    patternColor := color.lime
else if isCup
    patternName := "CUP & HANDLE"
    patternScore := 80
    patternColor := color.green
else if isDoubleBottom
    patternName := "DOUBLE BOTTOM"
    patternScore := 75
    patternColor := color.green
else if isFlatBase
    patternName := "FLAT BASE"
    patternScore := 70
    patternColor := color.teal
else if isAscending
    patternName := "ASCENDING BASE"
    patternScore := 72  // Legitimate Minervini pattern - qualifies
    patternColor := color.blue
else if hasVCPchar and pricePosPct >= 50
    patternName := "FORMING..."
    patternScore := 40
    patternColor := color.yellow
else if pricePosPct < 50
    patternName := "WEAK POS"
    patternScore := 20
    patternColor := color.orange
else if baseDepthPct > 50
    patternName := "TOO DEEP"
    patternScore := 15
    patternColor := color.red
else if not volHealthy
    patternName := "DISTRIBUTION"
    patternScore := 10
    patternColor := color.red

// Component scores
baseScore = baseDepthPct <= 15 ? 25 : baseDepthPct <= 25 ? 20 : baseDepthPct <= 35 ? 15 : baseDepthPct <= 50 ? 10 : 5
vcpScore = tCount >= 3 ? 25 : tCount >= 2 ? 20 : tCount >= 1 ? 10 : 0
volScore = (volHealthy ? 10 : 0) + (volDryUp ? 10 : 0) + (accumRatio >= 1.5 ? 5 : 0)
tightScore = (tightnessRatio < 0.7 ? 15 : tightnessRatio < 0.9 ? 10 : 5) + (higherLows ? 10 : 0)

// RS Momentum Bonus (Minervini: RS is critical for super stocks)
// Add bonus points when RS is very strong - this can push borderline setups over the threshold
int rsBonus = not na(rsNorm) and rsNorm >= 90 ? 10 : not na(rsNorm) and rsNorm >= 80 ? 5 : 0
patternScore := patternScore + rsBonus  // Apply RS bonus to pattern score

totalSetupScore = baseScore + vcpScore + volScore + tightScore + rsBonus

// ══════════════════════════════════════════════════════════════════
// COMBINED GRADE
// ══════════════════════════════════════════════════════════════════
string trendGrade = isStage2 ? "A+" : isStage2OK ? "B" : "F"
string setupGrade = patternScore >= 85 ? "A+" : patternScore >= 77 ? "A" : patternScore >= 50 ? "B" : patternScore >= 30 ? "C" : "F"

// Tier 1+2 qualification
bool tier12Qualified = isStage2 and patternScore >= 77
bool tier12Watch = (isStage2 or isStage2OK) and patternScore >= 40

// ══════════════════════════════════════════════════════════════════
// SUPER STOCK DETECTION (Minervini's Key Factor: RS Ranking)
// ══════════════════════════════════════════════════════════════════
// Minervini emphasizes: RS >= 90 is a hallmark of super stocks
// When RS is extremely high + breakout signals, this can override
// strict trend template requirements
bool rsVeryStrong = not na(rsNorm) and rsNorm >= 90  // Top 10% RS
bool rsStrong = not na(rsNorm) and rsNorm >= 80      // Top 20% RS
bool rsWeak = not na(rsNorm) and rsNorm < 70         // Bottom 30% RS - BLOCK ENTRY
bool rsAccelerating = not na(rsNorm) and rsNorm > rsNorm[5] and rsNorm > rsNorm[10]  // RS momentum
bool rsExtreme = not na(rsNorm) and rsNorm >= 95    // Top 5% RS - very rare

// Super Stock Candidate: RS >= 90 + basic Stage 2 conditions
// For extreme RS (>= 95), relax MA stacking requirement (price leads MAs in early breakout)
bool superStockCandidate = rsVeryStrong and isStage2OK and condPriceAboveAll and (condMaStacked or rsExtreme)

// Relaxed qualification when RS is very strong (Minervini's philosophy)
// If RS >= 90 and price structure is OK, we should not miss the opportunity
bool rsBasedQualified = superStockCandidate and patternScore >= 50

// ══════════════════════════════════════════════════════════════════
// PART 3: ENTRY TIMING (Tier 3)
// ══════════════════════════════════════════════════════════════════

// Entry = Pivot (baseHigh)
float entryLevel = baseHigh

// ═══════════════════════════════════════════════════════════════════
// 4 STOP LOSS METHODS
// ═══════════════════════════════════════════════════════════════════

// Method 1: Base Low (đáy tuyệt đối của base)
float stop1_BaseLow = baseLow
float stop1_Pct = (entryLevel - stop1_BaseLow) / entryLevel * 100
bool stop1_OK = stop1_Pct <= 8

// Method 2: Swing Low (đáy 10 bar gần nhất)
float stop2_SwingLow = ta.lowest(low, 10) * 0.99  // 1% buffer
float stop2_Pct = (entryLevel - stop2_SwingLow) / entryLevel * 100
bool stop2_OK = stop2_Pct <= 8

// Method 3: ATR Stop (2 ATR dưới entry)
float atrValue = ta.atr(14)
float stop3_ATR = entryLevel - (atrValue * 2)
float stop3_Pct = (entryLevel - stop3_ATR) / entryLevel * 100
bool stop3_OK = stop3_Pct <= 8

// Method 4: Minervini Method
// - Với VCP: dưới contraction cuối (dùng lowest của vcpSegLen bar)
// - Với Cup/Handle: dưới handle low
// - Với Double Bottom: dưới đáy thứ 2
// - Default: fixed 7% hoặc swing low (cái nào tight hơn)
float vcpTightStop = ta.lowest(low, vcpSegLen) * 0.99
float handleLow = ta.lowest(low, 5) * 0.99  // Pre-calculate handle low
float fixedStop = entryLevel * 0.93  // Fixed 7%
float minerviniStop = math.max(vcpTightStop, fixedStop)  // Lấy cái cao hơn (tight hơn)
// Nếu có pattern cụ thể, điều chỉnh
float stop4_Minervini = isVCP ? vcpTightStop : isCup ? handleLow : isDoubleBottom ? pivotLow3 * 0.99 : minerviniStop
float stop4_Pct = (entryLevel - stop4_Minervini) / entryLevel * 100
bool stop4_OK = stop4_Pct <= 8

// Count methods satisfying 8% rule
int stopMethodsOK = (stop1_OK ? 1 : 0) + (stop2_OK ? 1 : 0) + (stop3_OK ? 1 : 0) + (stop4_OK ? 1 : 0)

// Best stop = Minervini method (most aligned with philosophy)
float stopLevel = stop4_Minervini
float stopPct = stop4_Pct
bool tightStopOK = stop4_OK

// Take Profit Levels (Minervini: 20-25% typical)
float tp1Level = entryLevel * 1.20  // +20%
float tp2Level = entryLevel * 1.30  // +30%
float tp1Pct = 20.0
float tp2Pct = 30.0

// Risk/Reward Calculation (based on Minervini stop)
float riskReward = stopPct > 0 ? tp1Pct / stopPct : 0

// Add-on Zones (Pyramiding)
float addon1Level = entryLevel * 1.02  // +2% from pivot
float addon2Level = entryLevel * 1.05  // +5% from pivot

// ═══════════════════════════════════════════════════════════════════
// BREAKOUT DETECTION (Enhanced - handles gaps and normal breakouts)
// ═══════════════════════════════════════════════════════════════════
// ANTI-REPAINT FIX: Use baseHigh directly (already excludes current bar)
// Since baseHigh now uses high[1], baseHigh itself is the "prior pivot"
float priorPivot = baseHigh  // Already excludes current bar due to fix above
float gapPct = (open - close[1]) / close[1] * 100  // Gap percentage

// ═══════════════════════════════════════════════════════════════════
// ATL BREAKOUT DETECTION - ANTI-REPAINT FIX
// ═══════════════════════════════════════════════════════════════════
// Problem: barstate.isconfirmed is TRUE for ALL historical bars
// Solution: Use var to store breakout state, detect actual crossover

// Raw crossover conditions (for detection)
bool regularBreakoutCondition = close > priorPivot and close[1] <= priorPivot
bool gapBreakoutCondition = open > priorPivot and close[1] <= priorPivot and gapPct >= 2

// Store ATL breakout state using var
var bool atlBreakoutTriggered = false
var int atlBreakoutBar = 0
var string atlBreakoutType = "None"
var float atlBreakoutPivot = 0.0  // Track pivot level at breakout

// Detect new breakout:
// 1. First breakout (not triggered yet), OR
// 2. Breakout on NEW HIGHER pivot (pivot increased since last breakout)
bool isNewHigherPivot = priorPivot > atlBreakoutPivot * 1.005  // 0.5% threshold to avoid noise
bool isFirstBreakout = not atlBreakoutTriggered and (regularBreakoutCondition or gapBreakoutCondition)
bool isBreakoutOnNewPivot = atlBreakoutTriggered and isNewHigherPivot and (regularBreakoutCondition or gapBreakoutCondition)

if isFirstBreakout or isBreakoutOnNewPivot
    atlBreakoutTriggered := true
    atlBreakoutBar := bar_index
    atlBreakoutPivot := priorPivot
    atlBreakoutType := gapBreakoutCondition ? "Gap +" + str.tostring(gapPct, "#.#") + "%" : "Regular"

// Reset if price drops significantly below pivot
if close < priorPivot * 0.97
    atlBreakoutTriggered := false
    atlBreakoutBar := 0
    atlBreakoutType := "None"
    atlBreakoutPivot := 0.0

// Breakout signals - TRUE only on the bar they triggered
bool regularBreakout = atlBreakoutBar == bar_index and regularBreakoutCondition
bool gapBreakout = atlBreakoutBar == bar_index and gapBreakoutCondition
bool isBreakout = atlBreakoutBar == bar_index  // TRUE only on breakout bar

// Real-time versions for panel display (can show during the day)
bool regularBreakout_RT = regularBreakoutCondition
bool gapBreakout_RT = gapBreakoutCondition
bool isBreakout_RT = regularBreakout_RT or gapBreakout_RT

// Continuation zone (already broke out, still valid)
bool isInBreakoutZone = atlBreakoutTriggered and close > priorPivot
bool isPivotReady = pivotDist <= 3  // Within 3% of pivot

// For display
string breakoutType = isBreakout ? atlBreakoutType : isBreakout_RT ? (gapBreakout_RT ? "Gap +" + str.tostring(gapPct, "#.#") + "%" : "Regular") : isInBreakoutZone ? "Active" : "None"

// Volume Surge (Minervini: 150%+ ideal)
float volSurgePct = volume / volMA20 * 100
bool hasVolSurge = volSurgePct >= 150

// Market Condition (Benchmark trend)
float benchMA50 = request.security(benchmarkSymbol, timeframe.period, ta.sma(close, 50))
bool marketBullish = benchClose > benchMA50

// ═══════════════════════════════════════════════════════════════════
// PULLBACK BUY DETECTION (Minervini: "First normal pullback after breakout")
// ═══════════════════════════════════════════════════════════════════
// After a valid breakout, if price pulls back to pivot/EMA support with
// volume dry-up, then bounces → high-probability re-entry with tighter stop.

// Track pullback state
int barsSinceBreakout = atlBreakoutTriggered ? bar_index - atlBreakoutBar : 999
bool recentBreakout = atlBreakoutTriggered and barsSinceBreakout >= 2 and barsSinceBreakout <= 10

// Pullback conditions
float pullbackSupport = math.max(ema10, atlBreakoutPivot * 0.97)  // EMA10 or pivot -3%
bool pricePulledBack  = close <= atlBreakoutPivot * 1.03           // Back near pivot (+3%)
bool priceAboveSupport = close >= pullbackSupport                   // Holding support
bool pullbackVolDry   = volume < volMA50 * 0.7                     // Volume dried up
bool isBouncing       = close > open and close > close[1]          // Green candle, higher close
bool pullbackVolDry1  = volume[1] < volMA50 * 0.7                  // Previous bar also dry

// Pullback Buy Signal
bool isPullbackBuy = recentBreakout and pricePulledBack and priceAboveSupport and pullbackVolDry1 and isBouncing and marketBullish

// Pullback stop (tighter than breakout stop)
float pullbackSwingLow = ta.lowest(low, 5)
float pullbackStop     = math.max(pullbackSwingLow * 0.99, atlBreakoutPivot * 0.97)
float pullbackStopPct  = close > 0 ? (close - pullbackStop) / close * 100 : 99
bool  pullbackStopOK   = pullbackStopPct <= 5  // Tighter stop: max 5%

// Real-time pullback signal
bool isPullbackBuy_RT = recentBreakout and pricePulledBack and priceAboveSupport and (pullbackVolDry or pullbackVolDry1) and isBouncing and marketBullish

// ═══════════════════════════════════════════════════════════════════
// LOW-CHEAT PIVOT ENTRY (Minervini: buy at bottom of last contraction)
// ═══════════════════════════════════════════════════════════════════
// Buy BEFORE breakout when VCP is clear (T>=2) and price is at contraction low
// Stop = just below contraction low (very tight, 2-4%)
float lowCheatStop    = lastContractionLow * 0.98
float lowCheatStopPct = close > 0 ? (close - lowCheatStop) / close * 100 : 99
bool  lowCheatStopOK  = lowCheatStopPct <= 4  // Max 4% stop
bool  lowCheatEntry   = isLowCheat and lowCheatStopOK and marketBullish and not atlBreakoutTriggered
bool  lowCheatEntry_RT = lowCheatEntry  // Same for RT (no breakout dependency)

// ═══════════════════════════════════════════════════════════════════
// TREND REVERSAL / DECLINE SIGNALS (Minervini Exit Philosophy)
// ═══════════════════════════════════════════════════════════════════

// Momentum Signals
bool breakMA10 = close < ta.sma(close, 10)  // Momentum loss
bool breakMA20 = close < ma20               // Short-term trend weakening
bool breakMA50 = close < ma50               // Medium-term trend loss

// Price Action Signals (use priorPivot for consistency)
bool failedBreakout = close < priorPivot and close[1] >= priorPivot  // Pivot rejection
bool lowerHigh = high < ta.highest(high, 5)[1]  // Weakening highs
bool lowerLow = low < ta.lowest(low, 5)[1]      // Breaking support

// Volume Signals
bool volClimax = volume > volMA20 * 3 and close < open  // Distribution day
bool volDryUpOnUp = close > close[1] and volume < volMA20 * 0.5  // Weak rally

// ═══════════════════════════════════════════════════════════════════
// ADVANCED EXIT SIGNALS (Minervini Philosophy)
// ═══════════════════════════════════════════════════════════════════

// 1. CLIMAX TOP - Extremely high volume = exhaustion/distribution
// Minervini: Climax top occurs AFTER an extended advance, not on first breakout
// When volume is TOO high (400%+), smart money is often SELLING into strength
float priceChange = math.abs(close - open) / open * 100
float distFromMA20 = (close - ma20) / ma20 * 100  // Distance from MA20 as percentage
bool isClimaxVolume = volSurgePct >= 400  // 4x average volume
bool isExtended = distFromMA20 >= 7.0     // Price 7%+ above MA20 (extended advance)
float barRangePct = (high - low) / low * 100
float atrThreshold = ta.atr(14) / close * 100 * 1.5
bool isWideBar = barRangePct > atrThreshold  // 1.5x ATR
// Climax Top: Extreme volume + extended price (after significant advance)
bool climaxTop = isClimaxVolume and (isExtended or isWideBar)

// 2. CHURNING - High volume but little price progress (smart money distributing)
// Stock struggles to advance despite heavy volume
float priceProgress5 = (close - close[5]) / close[5] * 100  // 5-day price change
float avgVol5 = ta.sma(volume, 5)
bool highVol5Days = avgVol5 > volMA20 * 1.5  // High volume over 5 days
bool littleProgress = math.abs(priceProgress5) < 3  // Less than 3% move
bool churning = highVol5Days and littleProgress and close > ma50  // Only valid in uptrend

// 3. RS LINE DIVERGENCE - RS weakening while price still rising
// Early warning: stock losing relative strength vs market
float rsChange5 = not na(rsNorm) and not na(rsNorm[5]) ? rsNorm - rsNorm[5] : 0
float rsChange10 = not na(rsNorm) and not na(rsNorm[10]) ? rsNorm - rsNorm[10] : 0
bool priceUp5 = close > close[5]
bool rsDown5 = rsChange5 < -5  // RS dropped 5+ points
bool rsDivergence = priceUp5 and rsDown5  // Price up but RS down = divergence

// 4. LATE-STAGE BASE COUNTER - 3rd+ base has higher failure rate
// Count significant pullbacks (>10%) as base formations
var int baseCount = 0
float pullbackPct = (ta.highest(high[1], 50) - low) / ta.highest(high[1], 50) * 100
bool newBase = pullbackPct >= 10 and pullbackPct[1] < 10  // New pullback started
if newBase
    baseCount := baseCount + 1
if close < ma200  // Reset count if trend breaks
    baseCount := 0
bool lateStageBase = baseCount >= 3  // 3rd base or later = higher risk

// Volatility Signals
float trailATR = ta.highest(high[1], 10) - ta.atr(10) * 2  // Trailing ATR level
bool breakTrailATR = close < trailATR

// ═══════════════════════════════════════════════════════════════════
// MARKET TIMING: Distribution Day Count & Follow-through Day
// ═══════════════════════════════════════════════════════════════════
// Get benchmark (market) data
float benchVolume = request.security(benchmarkSymbol, timeframe.period, volume)
float benchVolMA = request.security(benchmarkSymbol, timeframe.period, ta.sma(volume, 50))
float benchChange = (benchClose - benchClose[1]) / benchClose[1] * 100

// Distribution Day: Index drops ≥0.2% on higher volume
bool isDistributionDay = benchChange <= -0.2 and benchVolume > benchVolume[1]

// Count distribution days in last 25 trading days
var int distDayCount = 0
if bar_index >= 25
    distDayCount := 0
    for i = 0 to 24
        if benchClose[i] < benchClose[i+1] * 0.998 and benchVolume[i] > benchVolume[i+1]
            distDayCount := distDayCount + 1

// Follow-through Day Detection
// After correction low, look for day 4-7 with ≥1.25% gain on higher volume
float benchLow10 = ta.lowest(benchClose, 10)
bool isAttemptedRally = benchClose > benchLow10 * 1.01  // 1% above recent low
var int rallyDayCount = 0
if benchClose < benchClose[1]
    rallyDayCount := 0  // Reset on down day
else if isAttemptedRally
    rallyDayCount := rallyDayCount + 1

bool isFollowThroughDay = rallyDayCount >= 4 and rallyDayCount <= 10 and benchChange >= 1.25 and benchVolume > benchVolume[1]

// Market Health based on distribution count
string marketHealth = distDayCount <= 2 ? "HEALTHY" : distDayCount <= 4 ? "CAUTION" : "HIGH RISK"
color marketHealthColor = distDayCount <= 2 ? color.green : distDayCount <= 4 ? color.orange : color.red

// ═══════════════════════════════════════════════════════════════════
// FUNDAMENTAL ANALYSIS (Minervini Philosophy - Independent Section)
// ═══════════════════════════════════════════════════════════════════
// Minervini: "Earnings are the most important fundamental factor"
// EPS growth 25%+ QoQ, Revenue growth 20%+, Accelerating growth = ideal

// Get fundamental data - only when enabled (avoid runtime errors on indices/forex/crypto)
// User must enable this manually for stocks - disable for VNINDEX, crypto, forex
bool isStock = syminfo.type == "stock"
float epsQ = enableFundamentals ? request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE", "FQ", barmerge.gaps_off, true) : na
float epsTTM = enableFundamentals ? request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE", "TTM", barmerge.gaps_off, true) : na
float revQ = enableFundamentals ? request.financial(syminfo.tickerid, "TOTAL_REVENUE", "FQ", barmerge.gaps_off, true) : na
float revTTM = enableFundamentals ? request.financial(syminfo.tickerid, "TOTAL_REVENUE", "TTM", barmerge.gaps_off, true) : na

// Note: request.earnings() removed due to syntax issues
// Earnings surprise will be calculated differently if needed
float epsActual = na
float epsEstimate = na

// Track previous quarter values using var and change detection
var float prevEpsQ = na
var float prevRevQ = na
var float savedEpsQ1 = na
var float savedRevQ1 = na

// When EPS changes, save previous value
if ta.change(epsQ) != 0 and not na(prevEpsQ)
    savedEpsQ1 := prevEpsQ
prevEpsQ := epsQ

// When Revenue changes, save previous value
if ta.change(revQ) != 0 and not na(prevRevQ)
    savedRevQ1 := prevRevQ
prevRevQ := revQ

// Calculate growth rates
float epsGrowthQoQ = not na(epsQ) and not na(savedEpsQ1) and savedEpsQ1 != 0 ? (epsQ - savedEpsQ1) / math.abs(savedEpsQ1) * 100 : na
float revGrowthQoQ = not na(revQ) and not na(savedRevQ1) and savedRevQ1 != 0 ? (revQ - savedRevQ1) / math.abs(savedRevQ1) * 100 : na

// Earnings surprise (actual vs estimate)
float epsSurprise = not na(epsActual) and not na(epsEstimate) and epsEstimate != 0 ? (epsActual - epsEstimate) / math.abs(epsEstimate) * 100 : na
bool earningsBeat = not na(epsSurprise) and epsSurprise > 0

// P/E and PEG Ratio (Minervini: PEG < 1 is ideal, < 1.5 is acceptable)
// PEG = P/E / EPS Growth Rate
float peRatio = not na(epsTTM) and epsTTM > 0 ? close / epsTTM : na
float pegRatio = not na(peRatio) and not na(epsGrowthQoQ) and epsGrowthQoQ > 0 ? peRatio / epsGrowthQoQ : na
bool pegIdeal = not na(pegRatio) and pegRatio < 1.0      // PEG < 1 = undervalued
bool pegOK = not na(pegRatio) and pegRatio < 1.5         // PEG < 1.5 = acceptable
bool pegHigh = not na(pegRatio) and pegRatio >= 2.0      // PEG >= 2 = overvalued

// Fundamental Score (Minervini criteria)
int fundScore = 0
bool epsPositive = not na(epsQ) and epsQ > 0
bool epsGrowthOK = not na(epsGrowthQoQ) and epsGrowthQoQ >= 25  // 25%+ QoQ
bool epsAccel = not na(epsGrowthQoQ) and epsGrowthQoQ >= 40     // Accelerating
bool revGrowthOK = not na(revGrowthQoQ) and revGrowthQoQ >= 20  // 20%+ QoQ
bool revAccel = not na(revGrowthQoQ) and revGrowthQoQ >= 30     // Accelerating

// Score: EPS(20) + Growth(25) + Accel(10) + Rev(20) + RevAccel(10) + PEG(15)
fundScore := (epsPositive ? 20 : 0) + (epsGrowthOK ? 25 : 0) + (epsAccel ? 10 : 0) + (revGrowthOK ? 20 : 0) + (revAccel ? 10 : 0) + (pegIdeal ? 15 : pegOK ? 10 : 0)

// Fundamental Grade
string fundGrade = fundScore >= 80 ? "A+" : fundScore >= 60 ? "A" : fundScore >= 40 ? "B" : fundScore >= 20 ? "C" : "F"
string fundStatus = fundScore >= 80 ? "EXCELLENT" : fundScore >= 60 ? "GOOD" : fundScore >= 40 ? "FAIR" : fundScore >= 20 ? "WEAK" : "N/A"
bool fundDataAvailable = not na(epsQ) or not na(revQ)

// Count warning signals (including new ones)
int warningCount = (breakMA10 ? 1 : 0) + (breakMA20 ? 1 : 0) + (breakMA50 ? 1 : 0) + (lowerHigh ? 1 : 0) + (volClimax ? 1 : 0) + (breakTrailATR ? 1 : 0) + (climaxTop ? 1 : 0) + (churning ? 1 : 0) + (rsDivergence ? 1 : 0) + (lateStageBase ? 1 : 0)

// Trend Status - Reversal/Decline Detection (Priority order)
string trendStatus = "HEALTHY"
color trendColor = color.green
string trendDetail = ""

if climaxTop
    trendStatus := "🔴 CLIMAX TOP"
    trendDetail := "Vol " + str.tostring(volSurgePct, "#") + "% = Exhaustion!"
    trendColor := color.red
else if failedBreakout
    trendStatus := "⚠️ REVERSAL"
    trendDetail := "Pivot rejected - price back below"
    trendColor := color.red
else if volClimax
    trendStatus := "⚠️ DISTRIBUTION"
    trendDetail := "High volume + red candle = selling"
    trendColor := color.red
else if churning
    trendStatus := "⚠️ CHURNING"
    trendDetail := "High vol, no progress = distribution"
    trendColor := color.red
else if breakMA50
    trendStatus := "🔴 DOWNTREND"
    trendDetail := "Below MA50 - trend broken"
    trendColor := color.red
else if rsDivergence
    trendStatus := "🟠 RS DIVERGENCE"
    trendDetail := "RS falling while price rising"
    trendColor := color.orange
else if breakMA20 and breakMA10
    trendStatus := "🟠 WEAKENING"
    trendDetail := "Below MA10 & MA20"
    trendColor := color.orange
else if breakTrailATR
    trendStatus := "🟠 PULLBACK"
    trendDetail := "Below trailing ATR stop"
    trendColor := color.orange
else if lateStageBase
    trendStatus := "🟠 LATE STAGE"
    trendDetail := "Base #" + str.tostring(baseCount) + " - higher fail rate"
    trendColor := color.orange
else if breakMA10
    trendStatus := "🟡 CAUTION"
    trendDetail := "Below MA10 - momentum loss"
    trendColor := color.yellow
else if lowerHigh and lowerLow
    trendStatus := "🟡 WATCH"
    trendDetail := "Lower highs & lows forming"
    trendColor := color.yellow
else if warningCount >= 3
    trendStatus := "🟡 MULTIPLE WARNINGS"
    trendDetail := str.tostring(warningCount) + " signals active"
    trendColor := color.yellow
else
    trendStatus := "🟢 HEALTHY"
    trendDetail := "No reversal signals"
    trendColor := color.green

// Entry Readiness - Based on Minervini Philosophy ONLY
// Minervini requires: Breakout + Volume surge + Market bullish + Stop <= 8%
bool minerviniStopOK = stop4_OK  // Minervini method stop <= 8%

// Fresh breakout = new breakout today with volume
// DUAL SIGNAL SYSTEM:
// - _RT versions: Real-time for live monitoring & alerts (can repaint within the day)
// - Non-RT versions: Confirmed signals for bar coloring & history (no repaint)
bool freshBreakout_RT = isBreakout_RT and hasVolSurge and marketBullish and minerviniStopOK  // Real-time
bool freshBreakout = isBreakout and hasVolSurge and marketBullish and minerviniStopOK        // Confirmed

// Active breakout = already broke out, still in buy zone (for add-on or late entry)
bool activeBreakout = isInBreakoutZone and marketBullish and minerviniStopOK and not isBreakout_RT

// Combined entry ready
// entryReady_RT: Hiển thị trong ngày khi điều kiện đạt (cho panel & alert)
// entryReady: Chỉ TRUE khi nến đóng cửa (cho bar color & lịch sử)
bool entryReady_RT = freshBreakout_RT  // Real-time for panel display
bool entryReady = freshBreakout        // Confirmed for bar coloring
bool entryActive = activeBreakout      // Post-breakout, still valid
bool entryWatch = isPivotReady and volDryUp and marketBullish and not isBreakout_RT and not isInBreakoutZone and minerviniStopOK

// Pullback Buy entry (qualified + pullback conditions + stop OK)
// Note: isQualified defined below; use tier12Qualified/rsBasedQualified directly
bool entryPullback_RT = isPullbackBuy_RT and pullbackStopOK and (tier12Qualified or rsBasedQualified)
bool entryPullback = isPullbackBuy and pullbackStopOK and (tier12Qualified or rsBasedQualified)

// Low-Cheat Pivot entry (qualified + low-cheat conditions)
bool entryLowCheat_RT = lowCheatEntry_RT and (tier12Qualified or rsBasedQualified)
bool entryLowCheat = lowCheatEntry and (tier12Qualified or rsBasedQualified)

// Entry Grade based on Minervini criteria ONLY
// A+ = Fresh breakout with volume
// A  = Pullback buy (tighter stop, higher win rate)
// A  = Active breakout zone (already broke out)
// A- = Low-cheat pivot (pre-breakout, best R:R)
// A- = Near entry, waiting for trigger
// B  = Setup OK but waiting
// C  = Stop too wide or market weak
// F  = Not tradeable per Minervini
// Use _RT for live display in panel (shows signal during the day)
string entryGrade = entryReady_RT ? "A+" : entryPullback_RT ? "A" : entryActive ? "A" : entryLowCheat_RT ? "A-" : entryWatch ? "A-" : (minerviniStopOK and marketBullish) ? "B" : minerviniStopOK ? "C" : "F"
string entryStatus = entryReady_RT ? "BUY!" : entryPullback_RT ? "PULLBACK BUY!" : entryActive ? "ADD/HOLD" : entryLowCheat_RT ? "LOW-CHEAT!" : entryWatch ? "READY" : minerviniStopOK ? "WATCH" : "WAIT"

// Reference: Other stop methods count (for comparison only)
string refStopInfo = str.tostring(stopMethodsOK) + "/4 methods ≤8%"

// ══════════════════════════════════════════════════════════════════
// SYNCHRONIZED VERDICT (All 3 Tiers + RS Override)
// ══════════════════════════════════════════════════════════════════
// BUY = (Tier1+2 qualified OR RS-based qualified) AND Fresh breakout with volume
// ADD/HOLD = (Tier1+2 qualified OR RS-based qualified) AND Active breakout zone
// READY = (Tier1+2 qualified OR RS-based qualified) AND Entry watch
// WATCH = Tier1+2 watch level OR Super stock candidate forming
// SKIP = Not qualified

// Combined qualification: strict OR RS-based (for super stocks)
bool isQualified = tier12Qualified or rsBasedQualified

// DUAL SIGNALS for verdict:
// isBuyNow_RT: Real-time for panel display & alerts (shows during the day)
// isBuyNow: Confirmed for bar coloring (only after bar closes)
bool isBuyNow_RT = isQualified and entryReady_RT and rsStrong  // Real-time for panel (RS >= 80)
bool isBuyNow = isQualified and entryReady and rsStrong        // Confirmed for bar color (RS >= 80)
bool isPullbackBuyNow_RT = entryPullback_RT and rsStrong       // Pullback buy real-time
bool isPullbackBuyNow = entryPullback and rsStrong             // Pullback buy confirmed
bool isLowCheatNow_RT = entryLowCheat_RT and rsStrong          // Low-cheat real-time
bool isLowCheatNow = entryLowCheat and rsStrong                // Low-cheat confirmed
bool isAddHold = isQualified and entryActive and rsStrong      // RS >= 80 required for ADD
bool isReadyToBuy = isQualified and entryWatch
bool isSuperStockWatch = superStockCandidate and not isQualified and not isBuyNow and not isAddHold  // Potential super stock forming
bool isWatchlist = (tier12Watch or isSuperStockWatch) and not isQualified and not isAddHold
bool isSkip = not tier12Watch and not superStockCandidate

// Any buy signal (breakout, pullback, or low-cheat)
bool anyBuyNow_RT = isBuyNow_RT or isPullbackBuyNow_RT or isLowCheatNow_RT
bool anyBuyNow = isBuyNow or isPullbackBuyNow or isLowCheatNow
string buyType = isBuyNow_RT ? "Breakout" : isPullbackBuyNow_RT ? "Pullback" : isLowCheatNow_RT ? "Low-Cheat" : "None"

// ATL Signal Memory - track last BUY for panel display
var int lastATLBuyBar = 0
var float lastATLBuyClose = 0.0
var float lastATLPivot_mem = 0.0
var string lastATLBuyType = ""
if anyBuyNow
    lastATLBuyBar := bar_index
    lastATLBuyClose := close
    lastATLPivot_mem := entryLevel
    lastATLBuyType := buyType
int atlBarsAgo = lastATLBuyBar > 0 ? bar_index - lastATLBuyBar : -1

// ══════════════════════════════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════════════════════════════
plot(showMA20 ? ma20 : na,  "MA20",  color=color.new(color.white, 0),  linewidth=1)
plot(showMA50 ? ma50 : na,  "MA50",  color=color.new(color.green, 0),  linewidth=1)
plot(showMA150 ? ma150 : na, "MA150", color=color.new(color.orange, 0), linewidth=1)
plot(showMA200 ? ma200 : na, "MA200", color=color.new(color.red, 0),    linewidth=1)
plot(showPivot ? baseHigh : na, "Entry/Pivot", color=color.new(color.aqua, 0), style=plot.style_circles, linewidth=2)
plot(showStopTP ? stopLevel : na, "Stop Loss", color=color.new(color.red, 30), style=plot.style_cross, linewidth=1)
plot(showStopTP ? tp1Level : na, "TP1 (+20%)", color=color.new(color.lime, 50), style=plot.style_cross, linewidth=1)
plot(showStopTP ? addon1Level : na, "Add-on +2%", color=color.new(color.yellow, 70), style=plot.style_circles, linewidth=1)

// Bar color - AUTO SWITCH between ATL (Minervini) and BTL (Weinstein-Darvas)
color barCol = color.new(color.gray, 40)

if isAboveTheLine
    // ATL Mode: Minervini colors (Lime/Yellow/Orange/Fuchsia/Teal/Blue)
    barCol := isWatchlist ? color.new(color.orange, 0) : barCol
    barCol := isSuperStockWatch ? color.new(color.fuchsia, 0) : barCol
    barCol := isReadyToBuy ? color.new(color.yellow, 0) : barCol
    barCol := isLowCheatNow ? color.new(color.blue, 0) : barCol          // Low-cheat = blue
    barCol := isAddHold ? color.new(color.aqua, 0) : barCol
    barCol := isPullbackBuyNow ? color.new(color.teal, 0) : barCol       // Pullback = teal
    barCol := isBuyNow and rsBasedQualified ? color.new(color.fuchsia, 0) : barCol
    barCol := isBuyNow and not rsBasedQualified ? color.new(color.lime, 0) : barCol
else
    // BTL Mode: Weinstein-Darvas colors (Lime for BUY, Blue/Cyan for others)
    barCol := btlWatchSignal ? color.new(color.aqua, 0) : barCol
    barCol := btlReadySignal ? color.new(color.blue, 0) : barCol
    barCol := btlBuySignal ? color.new(color.lime, 0) : barCol

barcolor(barCol)

// Background - synchronized with mode
color bgCol = na
if isAboveTheLine
    bgCol := anyBuyNow ? color.new(color.lime, 90) : isAddHold ? color.new(color.aqua, 90) : isReadyToBuy ? color.new(color.green, 92) : isSuperStockWatch ? color.new(color.fuchsia, 95) : isWatchlist ? color.new(color.yellow, 95) : na
else
    bgCol := btlBuySignal ? color.new(color.lime, 90) : btlReadySignal ? color.new(color.blue, 92) : btlWatchSignal ? color.new(color.aqua, 95) : na
bgcolor(bgCol)


// Switch Point Markers (BTL ↔ ATL transitions)
plotshape(switchToATL, "↑ Switch to ATL", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="ATL")
plotshape(switchToBTL, "↓ Switch to BTL", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="BTL")

// Stage 1 Breakout Marker (BTL mode only - Weinstein)
plotshape(isBelowTheLine and wStage1Breakout, "Stage 1 Breakout", style=shape.diamond, location=location.belowbar, color=color.blue, size=size.small, text="S1→2")

// Plot Darvas Box levels when in BTL mode
plot(isBelowTheLine and showPivot ? darvasHigh : na, "Darvas Box High", color=color.new(color.blue, 30), style=plot.style_circles, linewidth=2)
plot(isBelowTheLine and showStopTP ? darvasLow : na, "Darvas Box Low", color=color.new(color.blue, 50), style=plot.style_cross, linewidth=1)

// ══════════════════════════════════════════════════════════════════
// INFO PANEL (Fixed position - Top Right)
// ══════════════════════════════════════════════════════════════════
var table infoPanel = table.new(position.top_right, 1, 1, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if barstate.islast
    // Header with symbol, timeframe, date + MODE indicator
    string modeIndicator = isAboveTheLine ? "🔺 ABOVE THE LINE (Minervini)" : "🔻 BELOW THE LINE (Weinstein-Darvas)"
    string headerInfo = syminfo.ticker + "  |  " + timeframe.period + "  |  " + str.tostring(year) + "/" + str.tostring(month) + "/" + str.tostring(dayofmonth) + "\nO:" + str.tostring(open, "#.#") + " H:" + str.tostring(high, "#.#") + " L:" + str.tostring(low, "#.#") + " C:" + str.tostring(close, "#.#") + "  |  Vol:" + str.tostring(volume / 1000, "#.#") + "K  B/S:" + str.tostring(buyPct, "#") + "/" + str.tostring(100 - buyPct, "#") + "%  Avg:" + str.tostring(volMa / 1000, "#.#") + "K"
    
    // ═══════════════════════════════════════════════════════════════════
    // PANEL CONTENT - AUTO SWITCH BASED ON MODE
    // ═══════════════════════════════════════════════════════════════════
    string panelText = ""
    color panelBgColor = color.new(color.gray, 80)
    
    if isAboveTheLine
        // ═══════════════════════════════════════════════════════════════════
        // ATL MODE: MINERVINI PANEL (Original)
        // ═══════════════════════════════════════════════════════════════════
        string qualifyMethod = rsBasedQualified and not tier12Qualified ? " [RS]" : ""
        // Use _RT for real-time panel display (shows signal during the day)
        // Unified verdict labels (consistent with BTL)
        string verdict = isBuyNow_RT ? "★★★ ATL BUY ★★★" : isPullbackBuyNow_RT ? "★★★ ATL PULLBACK BUY ★★★" : isLowCheatNow_RT ? "★★★ ATL LOW-CHEAT ★★★" : isAddHold ? "★★ ATL HOLD ★★" : isReadyToBuy ? "★★ ATL READY ★★" : isQualified ? "○ ATL WATCH ○" : isSuperStockWatch ? "◆ ATL FORMING ◆" : isWatchlist ? "◆ ATL FORMING ◆" : "-- SKIP --"
        
        string trendIcon = isStage2 ? "🟢" : isStage2OK ? "🟡" : "🔴"
        string setupIcon = patternScore >= 85 ? "🟢" : patternScore >= 70 ? "🟢" : patternScore >= 50 ? "🟡" : patternScore >= 30 ? "🟠" : "🔴"
        string entryIcon = entryReady_RT ? "🟢" : entryPullback_RT ? "🟢" : entryLowCheat_RT ? "🟢" : entryActive ? "🟢" : entryWatch ? "🟡" : isPivotReady ? "🟠" : "🔴"
        string rsIcon = rsVeryStrong ? "🔥" : rsStrong ? "🟢" : "🟡"
        
        string entryConclusion = ""
        if isSkip
            entryConclusion := "⚠️ NO TRADE - Trend/Setup not qualified"
        else if rsWeak
            entryConclusion := "🔴 NO ENTRY - RS < 70 (laggard, not leader)"
        else if not minerviniStopOK
            entryConclusion := "🔴 NO ENTRY - Stop > 8% (Minervini rule)"
        else if not marketBullish
            entryConclusion := "🟡 WAIT - Market weak, hold off"
        else if entryReady_RT and rsBasedQualified and not tier12Qualified
            entryConclusion := "🔥 BUY [RS OVERRIDE] - Super stock breakout!"
        else if entryReady_RT
            entryConclusion := "🟢 BUY - Breakout [" + breakoutType + "] + Volume!"
        else if isPullbackBuyNow_RT
            entryConclusion := "🟢 PULLBACK BUY - Post-BO pullback to support! Stop: " + str.tostring(pullbackStop, "#.#") + " (" + str.tostring(pullbackStopPct, "#.#") + "%)"
        else if isLowCheatNow_RT
            entryConclusion := "🟢 LOW-CHEAT - Buy at contraction low! Stop: " + str.tostring(lowCheatStop, "#.#") + " (" + str.tostring(lowCheatStopPct, "#.#") + "%)"
        else if entryActive and rsBasedQualified
            entryConclusion := "🟢 ADD/HOLD [RS] - Super stock in play"
        else if entryActive
            entryConclusion := "🟢 ADD/HOLD - In breakout zone, still valid"
        else if entryWatch
            entryConclusion := "🟡 READY - Wait for breakout + volume"
        else if superStockCandidate
            entryConclusion := "🔥 WATCH CLOSELY - Super stock candidate!"
        else
            entryConclusion := "⏳ WATCH - Setup forming, not ready"
        
        panelText := 
             headerInfo + "\n" +
             modeIndicator + "\n" +
             verdict + "\n" +
             "━━━━━━━━━━━━━━━━━━━━━━━━━\n" +
             trendIcon + " TREND (Minervini)  " + trendGrade + "  (" + str.tostring(trendScore) + "/10)\n" +
             "52W Near: " + (isNearHigh ? "YES" : "NO ") + "   |   Perf: " + (na(perf52w) ? "n/a " : str.tostring(perf52w, "#.#") + "%") + "   |   Dist: " + str.tostring(distFrom52High, "#.#") + "%\n" +
             rsIcon + " RS: " + str.tostring(rsNorm, "#.#") + (rsVeryStrong ? "★" : "") + "   |   RSIw: " + str.tostring(rsiWeekly, "#.#") + (rsiWeekly >= 70 ? "⚠OB" : rsiWeekly < 30 ? "✓OS" : "") + "   |   Vol: " + (condVolStrong ? "Strong" : "Weak  ") + "   |   MA: " + (condPriceAboveAll?"✓":"✗") + (condMaStacked?"✓":"✗") + (condMaSlope?"✓":"✗") + "\n" +
             "\n" +
             "━━━━━━━━━━━━━━━━━━━━━━━━━\n" +
             setupIcon + " SETUP (VCP/Pattern):  " + patternName + "\n" +
             "Grade: " + setupGrade + "   |   Score: " + str.tostring(patternScore) + "/100\n" +
             "Base: " + str.tostring(baseScore) + "/25   |   VCP: " + str.tostring(vcpScore) + "/25   |   Vol: " + str.tostring(volScore) + "/25   |   Tight: " + str.tostring(tightScore) + "/25" + (rsBonus > 0 ? "   |   RS+: " + str.tostring(rsBonus) : "") + "\n" +
             "Depth: " + str.tostring(baseDepthPct, "#.#") + "%   |   Pos: " + str.tostring(pricePosPct, "#.#") + "%   |   T-Count: " + str.tostring(tCount) + "/3\n" +
             "\n" +
             "━━━━━━━━━━━━━━━━━━━━━━━━━\n" +
             entryIcon + " ENTRY:  " + entryStatus + "  (" + entryGrade + ")\n" +
             "Pivot: " + str.tostring(entryLevel, "#.#") + "   |   Stop: " + str.tostring(stop4_Minervini, "#.#") + " (" + str.tostring(stop4_Pct, "#.#") + "%)   |   R:R: " + str.tostring(riskReward, "#.#") + ":1\n" +
             "TP: +" + str.tostring(tp1Pct, "#") + "%/+" + str.tostring(tp2Pct, "#") + "%   |   VolSurge: " + str.tostring(volSurgePct, "#") + "%   |   Market: " + (marketBullish ? "Bullish" : "Weak   ") + "\n" +
             (isPullbackBuy_RT ? "┌─ PULLBACK BUY ──────\n│ Support: EMA10=" + str.tostring(ema10, "#.#") + "  Pivot=" + str.tostring(atlBreakoutPivot, "#.#") + "\n│ Stop: " + str.tostring(pullbackStop, "#.#") + " (" + str.tostring(pullbackStopPct, "#.#") + "%)  VolDry: " + (pullbackVolDry ? "Yes✓" : "No") + "\n└────────────────────────────\n" : "") +
             (isLowCheat ? "┌─ LOW-CHEAT PIVOT ──────\n│ Contraction: " + str.tostring(lastContractionLow, "#.#") + " ~ " + str.tostring(lastContractionHigh, "#.#") + " (" + str.tostring(contractionRange, "#.#") + "%)\n│ Stop: " + str.tostring(lowCheatStop, "#.#") + " (" + str.tostring(lowCheatStopPct, "#.#") + "%)  T-Count: " + str.tostring(tCount) + "\n└────────────────────────────\n" : "") +
             "Add-on +2%: " + str.tostring(addon1Level, "#.#") + "   |   Add-on +5%: " + str.tostring(addon2Level, "#.#") + "\n" +
             entryConclusion + "\n" +
             "\n" +
             "┌─ STOP REF (" + refStopInfo + ") ────\n" +
             "│ BaseLow: " + str.tostring(stop1_Pct, "#.#") + "%" + (stop1_OK ? "✓" : "✗") + "   |   SwingLow: " + str.tostring(stop2_Pct, "#.#") + "%" + (stop2_OK ? "✓" : "✗") + "   |   ATR: " + str.tostring(stop3_Pct, "#.#") + "%" + (stop3_OK ? "✓" : "✗") + "   |   MM: " + str.tostring(stop4_Pct, "#.#") + "%" + (stop4_OK ? "✓" : "✗") + "\n" +
             "└────────────────────────────\n"
        
        // ATL Signal Memory - show if BUY signal within last 5 bars
        if atlBarsAgo >= 0 and atlBarsAgo <= 5
            panelText += "\n" +
                 "┌─ 📋 SIGNAL MEMORY ──────\n" +
                 "│ Last BUY: " + str.tostring(atlBarsAgo) + " bar(s) ago @ " + str.tostring(lastATLBuyClose, "#.#") + " [" + lastATLBuyType + "]\n" +
                 "│ Pivot: " + str.tostring(lastATLPivot_mem, "#.#") + "\n" +
                 "│ 🟢 Buy Range: " + str.tostring(lastATLPivot_mem, "#.#") + " ~ " + str.tostring(lastATLPivot_mem * 1.03, "#.#") + " (pivot ~ +3%)\n" +
                 "│ 🔴 KHÔNG MUA nếu ATO > " + str.tostring(lastATLPivot_mem * 1.05, "#.#") + " (extended +5%)\n" +
                 "└────────────────────────────\n"

        // Use _RT for real-time panel background (shows during the day)
        panelBgColor := isBuyNow_RT and rsBasedQualified ? color.new(color.fuchsia, 80) : isBuyNow_RT ? color.new(color.lime, 80) : isPullbackBuyNow_RT ? color.new(color.teal, 80) : isLowCheatNow_RT ? color.new(color.blue, 80) : isAddHold ? color.new(color.aqua, 80) : isReadyToBuy ? color.new(color.green, 80) : isQualified ? color.new(color.teal, 80) : isSuperStockWatch ? color.new(color.fuchsia, 85) : isWatchlist ? color.new(color.orange, 80) : color.new(color.gray, 80)
    
    else
        // ═══════════════════════════════════════════════════════════════════
        // BTL MODE: WEINSTEIN-DARVAS PANEL
        // ═══════════════════════════════════════════════════════════════════
        // Use _RT for real-time panel display
        // Unified verdict labels (consistent with ATL)
        string btlVerdict = btlBuySignal_RT ? "★★★ BTL BUY ★★★" : btlInPosition ? "★★ BTL HOLD ★★" : btlReadySignal ? "★★ BTL READY ★★" : btlWatchSignal ? "○ BTL WATCH ○" : wStage4 ? "-- SKIP --" : "◆ BTL FORMING ◆"
        string btlScoreInfo = "BTL Score: " + btlGrade + " (" + str.tostring(btlScore) + ")  [W:" + str.tostring(weinsteinScore) + " D:" + str.tostring(darvasScore) + " R:" + str.tostring(rsiEmaScore) + "]"
        
        string stageIcon = wStage2Early ? "🟢" : wStage1Breakout ? "🟢" : wStage3 ? "🟡" : wStage1 ? "🟡" : "🔴"
        string boxIcon = darvasBreakout and darvasVolConfirm ? "🟢" : validDarvasBox ? "🟡" : "🔴"
        // Use _RT for real-time panel display
        string btlEntryIcon = btlBuySignal_RT ? "🟢" : btlInPosition ? "🟢" : btlReadySignal ? "🟡" : "🔴"
        
        // BTL Entry Conclusion - use _RT for real-time display
        string btlConclusion = ""
        if not marketOKforBTL
            btlConclusion := "🔴 NO TRADE - Market Stage 4, avoid BTL"
        else if wStage4
            btlConclusion := "🔴 NO TRADE - Stock Stage 4 Decline"
        else if btlBuySignal_RT
            btlConclusion := "🟣 BUY (" + btlEntryType + ") - Entry triggered!"
        else if btlInPosition
            btlConclusion := "🟢 HOLD - In BTL position, monitor exit signals"
        else if btlReadySignal
            btlConclusion := "🟡 READY - Setup formed, wait for trigger"
        else if btlWatchSignal
            btlConclusion := "🔵 WATCH - Stage 1/2 or RSI oversold"
        else if wStage1Breakout
            btlConclusion := "🟢 BREAKOUT - Stage 1→2, look for Darvas box setup"
        else if wStage2Early
            btlConclusion := "🔵 ADVANCING - Stage 2, monitor for entry setup"
        else if wStage1
            btlConclusion := "⏳ BASING - Stage 1, accumulation phase"
        else if wStage3
            btlConclusion := "🟡 TOPPING - Stage 3, caution"
        else
            btlConclusion := "⏳ WAIT - Not in favorable stage"
        
        // BTL Stop calculation (Darvas Box Low)
        float btlStopLevel = darvasLow
        float btlStopPct = (close - btlStopLevel) / close * 100
        float btlTarget1 = close * 1.20  // 20% target
        float btlTarget2 = close * 1.35  // 35% target
        float btlRiskReward = btlStopPct > 0 ? 20 / btlStopPct : 0
        
        // RSI & EMA status icons
        string rsiIcon = weeklyOversold ? "🟢" : rsiWeekly < 40 ? "🟡" : "⚪"
        string emaIcon = emaCrossUp ? "🟢" : emaAbove ? "🟡" : "🔴"
        string mktIcon = marketOKforBTL ? "🟢" : "🔴"
        
        panelText := 
             headerInfo + "\n" +
             modeIndicator + "\n" +
             btlVerdict + "\n" +
             btlScoreInfo + "\n" +
             "━━━━━━━━━━━━━━━━━━━━━━━━━\n" +
             stageIcon + " STAGE (Weinstein)  " + weinsteinGrade + "  (" + str.tostring(weinsteinScore) + "/100)\n" +
             "Current Stage:  " + weinsteinStage + "\n" +
             "MA30W: " + str.tostring(ma30w, "#.#") + "   |   Price: " + (close > ma30w ? "Above ✓" : "Below  ") + "   |   Slope: " + (ma30wSlope > 0 ? "Rising ✓" : ma30wSlope < 0 ? "Falling⚠" : "Flat   ") + "\n" +
             "Stage 1 Breakout:  " + (wStage1Breakout ? "YES! ✓" : "No") + "\n" +
             "\n" +
             "━━━━━━━━━━━━━━━━━━━━━━━━━\n" +
             boxIcon + " SETUP (Darvas Box)  " + darvasGrade + "  (" + str.tostring(darvasScore) + "/100)\n" +
             "Box Status:  " + darvasStatus + "\n" +
             "Box High: " + str.tostring(darvasHigh, "#.#") + "   |   Box Low: " + str.tostring(darvasLow, "#.#") + "   |   Width: " + str.tostring(darvasWidth, "#.#") + "%" + (validDarvasBox ? "✓" : "✗") + "\n" +
             "Price Position:  " + str.tostring((close - darvasLow) / (darvasHigh - darvasLow) * 100, "#") + "% of Box\n" +
             "\n" +
             "━━━━━━━━━━━━━━━━━━━━━━━━━\n" +
             rsiIcon + " RSI/EMA  " + rsiEmaGrade + "  (" + str.tostring(rsiEmaScore) + "/55)\n" +
             "RSI Wkly: " + str.tostring(rsiWeekly, "#.#") + (weeklyOversold ? " OS✓" : wasOversoldRecently ? " WasOS✓(" + str.tostring(barsSinceOversold) + "d)" : " ✗") + "   |   EMA: " + (emaCrossUp ? "Cross✓" : emaAbove ? "Above✓" : "Below⚠") + "   |   Accum: " + (btlAccumulating ? "Yes✓" : "No  ") + " (" + str.tostring(accumRatio, "#.#") + "x)\n" +
             "\n" +
             "━━━━━━━━━━━━━━━━━━━━━━━━━\n" +
             btlEntryIcon + " ENTRY:  " + (btlBuySignal ? "BUY!" : btlReadySignal ? "READY" : "WAIT") + "  [" + btlEntryType + "]\n" +
             "Darvas BO: " + str.tostring(darvasHigh, "#.#") + "   |   Dist: " + str.tostring((darvasHigh - close) / close * 100, "#.#") + "%   |   RSI+EMA: " + (btlRsiOK ? "RSI✓" : "RSI⚠") + (btlEmaOK ? "+EMA✓" : "+EMA⚠") + "\n" +
             "Stop: " + str.tostring(btlStopLevel, "#.#") + " (" + str.tostring(btlStopPct, "#.#") + "%)   |   R:R: " + str.tostring(btlRiskReward, "#.#") + ":1   |   TP: +20%/+35%\n" +
             "Vol Confirm: " + str.tostring(volSurgePct, "#") + "%" + (darvasVolConfirm ? "✓" : " ") + "   |   Vol/7d: " + str.tostring(btlVolRatio7d, "#.##") + "x" + (btlVolRatio7d <= 0.7 ? " ✓quiet" : btlVolRatio7d > 1.3 ? " ⚠high" : "") + "\n" +
             "Pre-7d: " + str.tostring(btlPreMomentum7d, "#.#") + "%" + (btlPreMomentum7d <= 7 ? " ✓" : btlPreMomentum7d > 10 ? " ⚠extended" : " ~OK") + "   |   Candle: " + (close < open ? "RED" : "GREEN") + (close < open ? " ✓" : "") + "\n" +
             btlConclusion + "\n" +
             "\n" +
             "━━━━━━━━━━━━━━━━━━━━━━━━━\n" +
             mktIcon + " MARKET: " + (marketStage4 ? "Stage4⚠" : "OK ✓  ") + "   |   Index vs MA150: " + (benchClose > indexMA30w ? "Above" : "Below") + "\n" +
             "\n" +
             "┌─ BTL EXIT SIGNALS ─────\n" +
             "│ Status: " + btlExitStatus + "   |   StopHit: " + (btlStopHit ? "YES⚠" : "No  ") + "   |   Stage3: " + (btlStage3Warning ? "YES⚠" : "No  ") + "\n" +
             "│ Stage4: " + (btlEnterStage4 ? "YES⚠" : "No  ") + "   |   FailedBO: " + (btlFailedBreakout ? "YES⚠" : "No  ") + "\n" +
             "└────────────────────────────\n"
        
        // BTL Signal Memory - show if BUY signal within last 5 bars
        if btlBarsAgo >= 0 and btlBarsAgo <= 5
            panelText += "\n" +
                 "┌─ 📋 SIGNAL MEMORY ──────\n" +
                 "│ Last BUY: " + str.tostring(btlBarsAgo) + " bar(s) ago @ " + str.tostring(lastBTLBuyClose, "#.#") + "\n" +
                 "│ Darvas High: " + str.tostring(lastBTLDarvasHigh_mem, "#.#") + "\n" +
                 "│ 🟢 Buy Range: " + str.tostring(lastBTLDarvasHigh_mem, "#.#") + " ~ " + str.tostring(lastBTLDarvasHigh_mem * 1.03, "#.#") + " (breakout ~ +3%)\n" +
                 "│ 🔴 KHÔNG MUA nếu ATO > " + str.tostring(lastBTLDarvasHigh_mem * 1.05, "#.#") + " (extended +5%)\n" +
                 "│ ⚠ Dist Days: " + str.tostring(distDayCount) + "/5" + (distDayCount >= 5 ? " HIGH RISK - Cân nhắc KHÔNG MUA" : " OK") + "\n" +
                 "└────────────────────────────\n"

        // Use _RT for real-time panel background
        panelBgColor := btlBuySignal_RT ? color.new(color.lime, 80) : btlInPosition ? color.new(color.green, 80) : btlReadySignal ? color.new(color.blue, 80) : btlWatchSignal ? color.new(color.aqua, 85) : wStage4 ? color.new(color.red, 85) : color.new(color.gray, 80)
    
    // ═══════════════════════════════════════════════════════════════════
    // COMMON SECTIONS (Exit Signals, Market Timing, Fundamentals)
    // ═══════════════════════════════════════════════════════════════════
    panelText += "\n" +
         "━━━━━━━━━━━━━━━━━━━━━━━━━\n" +
         "📊 TREND HEALTH (If Holding)\n" +
         trendStatus + "\n" +
         trendDetail + "\n" +
         "MA10: " + (breakMA10 ? "Below⚠" : "Above✓") + "   |   MA20: " + (breakMA20 ? "Below⚠" : "Above✓") + "   |   MA50: " + (breakMA50 ? "Below⚠" : "Above✓") + "\n" +
         "TrailATR: " + str.tostring(trailATR, "#.#") + (breakTrailATR ? "⚠" : "✓") + "   |   Dist: " + (volClimax ? "YES⚠" : "No ✓") + "   |   FailBO: " + (failedBreakout ? "YES⚠" : "No ✓") + "\n" +
         "LowerHH: " + (lowerHigh ? "YES⚠" : "No ✓") + "   |   LowerLL: " + (lowerLow ? "YES⚠" : "No ✓") + "\n" +
         "┌─ ADVANCED SIGNALS ──────\n" +
         "│ ClimaxTop: " + (climaxTop ? "YES⚠" : "No  ") + "   |   Churning: " + (churning ? "YES⚠" : "No ✓") + "   |   RsDiv: " + (rsDivergence ? "YES⚠" : "No ✓") + "\n" +
         "│ LateStage: Base#" + str.tostring(baseCount) + (lateStageBase ? "⚠" : "✓") + "   |   Warnings: " + str.tostring(warningCount) + "/10\n" +
         "└────────────────────────────\n" +
         "\n" +
         "━━━━━━━━━━━━━━━━━━━━━━━━━\n" +
         "🏛️ MARKET TIMING\n" +
         "Dist Days (25d): " + str.tostring(distDayCount) + "/5  |  " + marketHealth + "\n" +
         (isFollowThroughDay ? "🟢 FOLLOW-THROUGH DAY!\n" : isDistributionDay ? "🔴 Distribution Day Today\n" : "") +
         "\n" +
         "━━━━━━━━━━━━━━━━━━━━━━━━━\n" +
         "📊 FUNDAMENTALS (" + fundGrade + ")\n" +
         (fundDataAvailable ? 
             "EPS: " + (na(epsQ) ? "n/a" : str.tostring(epsQ, "#.##")) + "   |   EPSGr: " + (na(epsGrowthQoQ) ? "n/a" : str.tostring(epsGrowthQoQ, "#.#") + "%") + (epsGrowthOK ? "✓" : "") + "   |   Rev: " + (na(revQ) ? "n/a" : str.tostring(revQ/1000000000, "#.##") + "B") + "\n" +
             "RevGr: " + (na(revGrowthQoQ) ? "n/a" : str.tostring(revGrowthQoQ, "#.#") + "%") + (revGrowthOK ? "✓" : "") + "   |   P/E: " + (na(peRatio) ? "n/a" : str.tostring(peRatio, "#.#")) + "   |   PEG: " + (na(pegRatio) ? "n/a" : str.tostring(pegRatio, "#.##")) + (pegIdeal ? "✓✓" : pegOK ? "✓" : pegHigh ? "⚠" : "") + "\n" +
             "Surprise: " + (na(epsSurprise) ? "n/a" : str.tostring(epsSurprise, "#.#") + "%") + (earningsBeat ? "✓Beat" : "") + "   |   " + fundStatus
         : "Data not available for this symbol")
    
    table.cell(infoPanel, 0, 0, panelText, text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=panelBgColor)
    
    // ═══════════════════════════════════════════════════════════════════
    // LOG TO CONSOLE - Full panel content for copying
    // Cách dùng: Bật "Log Panel to Console" → Mở Pine Editor → Console tab → Copy
    // ═══════════════════════════════════════════════════════════════════
    if enableLogToConsole
        log.info("═══════════════════════════════════════════════════════════")
        log.info("📋 FULL PANEL EXPORT - " + syminfo.ticker + " | " + timeframe.period)
        log.info("═══════════════════════════════════════════════════════════")
        log.info(panelText)
        log.info("═══════════════════════════════════════════════════════════")
    
    // ═══════════════════════════════════════════════════════════════════
    // PANEL EXPORT - Alert with full panel content for manual copying
    // Cách dùng: Bật "Enable Panel Export Alert" trong Settings
    // Tạo Alert với condition "any alert()" hoặc "PANEL EXPORT"
    // Khi alert fire, copy nội dung từ Alert Log
    // ═══════════════════════════════════════════════════════════════════
    if enablePanelExport
        bool shouldExport = isAboveTheLine ? (anyBuyNow_RT or isAddHold or isReadyToBuy) : (btlBuySignal_RT or btlReadySignal)
        if shouldExport
            alert("📋 PANEL EXPORT - " + syminfo.ticker + "\n" + panelText, alert.freq_once_per_bar_close)

// ══════════════════════════════════════════════════════════════════
// ALERTS - Use _RT for real-time alerts (trigger during the day)
// ══════════════════════════════════════════════════════════════════
// Synchronized Alerts (All 3 Tiers + RS) - Real-time
alertcondition(isBuyNow_RT and rsBasedQualified, "SUPER STOCK BUY!", "🔥 RS >= 90 + Breakout - SUPER STOCK!")
alertcondition(isBuyNow_RT and not rsBasedQualified, "BUY NOW", "ALL 3 TIERS CONFIRMED - BUY NOW!")
alertcondition(isAddHold, "ADD/HOLD", "In breakout zone - Add position or Hold!")
alertcondition(isReadyToBuy, "Ready to Buy", "Qualified, near pivot - READY!")
alertcondition(superStockCandidate and not isBuyNow_RT, "Super Stock Candidate", "🔥 RS >= 90 - Watch for breakout!")
alertcondition(isQualified and not entryReady_RT and not entryActive, "Wait Entry", "Qualified but wait for breakout!")

// Pattern Alerts
alertcondition(isPowerPlay, "Power Play", "Power Play pattern detected!")
alertcondition(isHTF, "High Tight Flag", "High Tight Flag pattern!")

// Entry Alerts - Real-time
alertcondition(isBreakout_RT, "Breakout", "Price broke above pivot!")
alertcondition(hasVolSurge and isBreakout_RT, "Volume Breakout", "Breakout with volume surge!")

// Pullback Buy & Low-Cheat Pivot Alerts (Minervini Advanced Entries)
alertcondition(isPullbackBuyNow_RT, "🟢 PULLBACK BUY", "Post-breakout pullback to support - tighter stop entry!")
alertcondition(isLowCheatNow_RT, "🔵 LOW-CHEAT PIVOT", "Buy at contraction low - best R:R entry before breakout!")

// Trend Reversal Alerts (If Holding)
alertcondition(failedBreakout, "Failed Breakout", "Pivot rejected - price back below!")
alertcondition(volClimax, "Distribution Day", "High volume + red candle = distribution!")
alertcondition(breakMA50, "Downtrend", "Below MA50 - trend broken!")
alertcondition(breakMA20 and breakMA10, "Weakening", "Below MA10 & MA20 - momentum loss!")
alertcondition(breakTrailATR, "Pullback", "Below trailing ATR stop!")
alertcondition(warningCount >= 3, "Multiple Warnings", "3+ reversal signals active!")

// Advanced Exit Alerts (Minervini Philosophy)
alertcondition(climaxTop, "🔴 CLIMAX TOP!", "Volume 400%+ = Exhaustion! Consider selling!")
alertcondition(churning, "⚠️ CHURNING", "High volume but no progress - smart money distributing!")
alertcondition(rsDivergence, "⚠️ RS DIVERGENCE", "RS falling while price rising - early warning!")
alertcondition(lateStageBase, "⚠️ LATE STAGE BASE", "Base 3+ - higher failure rate!")

// Market Timing Alerts
alertcondition(isFollowThroughDay, "🟢 FOLLOW-THROUGH DAY", "Market rally confirmed - increase exposure!")
alertcondition(distDayCount >= 5, "🔴 HIGH DISTRIBUTION", "5+ distribution days - reduce exposure!")
alertcondition(isDistributionDay, "⚠️ DISTRIBUTION DAY", "Market distribution day - be cautious!")

// BTL Mode Alerts (Weinstein-Darvas) - Use _RT for real-time alerts
alertcondition(btlBuySignal_RT, "🟣 BTL BUY - Darvas Breakout", "Below The Line: Darvas Box Breakout + Stage Transition!")
alertcondition(btlReadySignal, "🔵 BTL READY", "Below The Line: Box formed, ready for breakout!")
alertcondition(btlWatchSignal, "BTL WATCH", "Below The Line: Stage 1/2 forming, watch closely!")
alertcondition(switchToATL, "🔺 SWITCH TO ATL", "Transitioned from Below to Above The Line!")
alertcondition(switchToBTL, "🔻 SWITCH TO BTL", "Transitioned from Above to Below The Line!")
alertcondition(wStage1Breakout, "🟢 STAGE 1 BREAKOUT", "Weinstein Stage 1 Breakout - potential new uptrend!")
