//@version=5
indicator("us_rsline", shorttitle="RS_US", overlay=false)

//----------------------------
// Inputs - US STOCK VERSION
//----------------------------
benchmarkSymbol = input.symbol("SP:SPX", "Benchmark (S&P 500)", group="RS vs Market")
sectorSymbol    = input.symbol("", "Sector ETF (e.g. XLK, XLF, XLE)", group="RS vs Sector", tooltip="Leave empty to hide. Examples: AMEX:XLK (Tech), AMEX:XLF (Financials), AMEX:XLE (Energy), AMEX:XLV (Healthcare), AMEX:XLI (Industrials)")
showSector      = input.bool(true, "Show RS vs Sector", group="RS vs Sector")
smoothLength    = input.int(10, "SMA smoothing", minval=1, maxval=50, group="Settings")

//----------------------------
// RS vs MARKET (price / benchmark)
//----------------------------
benchClose = request.security(benchmarkSymbol, timeframe.period, close)
rsRaw      = benchClose != 0.0 ? close / benchClose : na

rsLookback = math.min(200, bar_index + 1)
rsHigh     = ta.highest(rsRaw, rsLookback)
rsLow      = ta.lowest(rsRaw, rsLookback)
rsRange    = rsHigh - rsLow
rsNorm     = rsRange != 0.0 ? 100.0 * (rsRaw - rsLow) / rsRange : na
rsSmooth   = ta.sma(rsNorm, smoothLength)

//----------------------------
// RS vs SECTOR (price / sector ETF)
//----------------------------
sectorClose  = sectorSymbol != "" ? request.security(sectorSymbol, timeframe.period, close) : na
secRsRaw     = not na(sectorClose) and sectorClose != 0.0 ? close / sectorClose : na

// Pre-compute on every bar (Pine requires consistent function calls)
float _secHigh   = ta.highest(secRsRaw, rsLookback)
float _secLow    = ta.lowest(secRsRaw, rsLookback)
secRsHigh    = not na(secRsRaw) ? _secHigh : na
secRsLow     = not na(secRsRaw) ? _secLow : na
secRsRange   = not na(secRsHigh) and not na(secRsLow) ? secRsHigh - secRsLow : na
secRsNorm    = not na(secRsRange) and secRsRange != 0.0 ? 100.0 * (secRsRaw - secRsLow) / secRsRange : na
float _secSmooth = ta.sma(secRsNorm, smoothLength)
secRsSmooth  = not na(secRsNorm) ? _secSmooth : na

bool hasSector = sectorSymbol != "" and showSector and not na(secRsNorm)

//----------------------------
// Plot - RS vs Market (purple)
//----------------------------
plot(rsNorm,   "RS vs Market",     color=color.new(color.purple, 0), linewidth=2)
plot(rsSmooth, "RS vs Market SMA", color=color.new(color.white, 30), linewidth=1)

//----------------------------
// Plot - RS vs Sector (orange) — only when sector input is provided
//----------------------------
plot(hasSector ? secRsNorm   : na, "RS vs Sector",     color=color.new(color.orange, 0), linewidth=2)
plot(hasSector ? secRsSmooth : na, "RS vs Sector SMA", color=color.new(color.yellow, 30), linewidth=1)

// Levels
hline(80, "RS 80 (Leader)", color=color.new(color.green, 70))
hline(70, "RS 70",          color=color.new(color.orange, 70))
hline(50, "RS 50",          color=color.new(color.gray, 70))
hline(20, "RS Weak",        color=color.new(color.red, 70))
